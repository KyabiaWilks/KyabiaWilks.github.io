		font-size: 18px;
		font-weight: bold;
		color: #333;
	}
	
	.form-group {
		margin-bottom: 15px;
	}
	
	.form-input, .form-textarea {
		width: 100%;
		padding: 12px 15px;
		border: 1px solid #ddd;
		border-radius: 8px;
		font-size: 14px;
		background: #fafafa;
	}
	
	.form-textarea {
		height: 100px;
		resize: none;
	}
	
	.submit-btn {
		width: 100%;
		background: #007AFF;
		border: none;
		border-radius: 8px;
		padding: 15px;
		margin-top: 10px;
	}
	
	.submit-btn:disabled {
		background: #ccc;
	}
	
	.submit-text {
		color: #ffffff;
		font-size: 16px;
		font-weight: 500;
	}
	
