	}
	
	.contact-info-item {
		display: flex;
		align-items: center;
	}
	
	.contact-icon {
		width: 40px;
		height: 40px;
		background: #f0f0f0;
		border-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-right: 15px;
	}
	
	.icon-text {
		font-size: 18px;
	}
	
	.contact-details {
		flex: 1;
	}
	
	.contact-label {
		display: block;
		font-size: 12px;
		color: #666;
		margin-bottom: 2px;
	}
	
	.contact-value {
		display: block;
		font-size: 14px;
		color: #333;
		font-weight: 500;
	}
	
	.social-links {
		display: flex;
		justify-content: space-around;
	}
	
	.social-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 15px;
		border-radius: 10px;
		background: #f8f9fa;
		min-width: 60px;
	}
	
