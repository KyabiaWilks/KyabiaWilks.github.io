<template>
	<view class="hero-container">
		<!-- 背景图片 -->
		<image class="hero-bg" src="/static/images/space.jpg" mode="aspectFill"></image>
		
		<!-- 内容区域 -->
		<view class="hero-content">
			<view class="hero-text">
				<text class="hero-title">Hello,</text>
				<text class="hero-subtitle">I'm Kyabia</text>
			</view>
			
			<!-- 导航按钮 -->
			<view class="nav-buttons">
				<button class="nav-btn" @click="navigateTo('/pages/works/works')">
					<text class="btn-text">查看作品</text>
				</button>
				<button class="nav-btn secondary" @click="navigateTo('/pages/about/about')">
					<text class="btn-text">关于我</text>
				</button>
			</view>
		</view>
		
		<!-- 装饰性边框 -->
		<view class="border-left"></view>
		<view class="border-right"></view>
		<view class="border-top"></view>
		<view class="border-bottom"></view>
	</view>
</template>

<script>
	export default {
		data() {
			return {
				title: 'Kyabia - 个人主页'
			}
		},
		onLoad() {
			console.log('首页加载完成')
		},
		methods: {
			navigateTo(url) {
				uni.navigateTo({
					url: url
				})
			}
		}
	}
</script>

<style>
	.hero-container {
		position: relative;
		width: 100%;
		height: 100vh;
		overflow: hidden;
	}
	
	.hero-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
	}
	
	.hero-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		height: 100%;
		padding: 40px;
		background: rgba(0, 0, 0, 0.3);
	}
	
	.hero-text {
		text-align: center;
		margin-bottom: 60px;
	}
	
	.hero-title {
		display: block;
		font-size: 48px;
		font-weight: bold;
		color: #ffffff;
		margin-bottom: 10px;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
	}
	
	.hero-subtitle {
		display: block;
		font-size: 32px;
		color: #ffffff;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
	}
	
	.nav-buttons {
		display: flex;
		flex-direction: column;
		gap: 20px;
		width: 200px;
	}
	
	.nav-btn {
		background: rgba(255, 255, 255, 0.9);
		border: none;
		border-radius: 25px;
		padding: 15px 30px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
		transition: all 0.3s ease;
	}
	
	.nav-btn.secondary {
		background: transparent;
		border: 2px solid #ffffff;
	}
	
	.btn-text {
		color: #333333;
		font-size: 16px;
		font-weight: 500;
	}
	
	.nav-btn.secondary .btn-text {
		color: #ffffff;
	}
	
	/* 装饰性边框 */
	.border-left, .border-right, .border-top, .border-bottom {
		position: absolute;
		background: #ffffff;
		z-index: 3;
	}
	
	.border-left {
		left: 0;
		top: 0;
		width: 4px;
		height: 100%;
	}
	
	.border-right {
		right: 0;
		top: 0;
		width: 4px;
		height: 100%;
	}
	
	.border-top {
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
	}
	
	.border-bottom {
		bottom: 0;
		left: 0;
		width: 100%;
		height: 4px;
	}
</style>
